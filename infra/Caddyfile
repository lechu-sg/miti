{
	servers {
		protocols h1 h2 h3
	}
}

{$MITI_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Descarga del APK. El listado muestra el archivo y su huella SHA-256.
	handle_path /descargas* {
		root * /srv/descargas
		file_server browse
		header Cache-Control "no-cache"
	}

	# Portada pública. Los archivos viajan en el repositorio (infra/portada).
	handle / {
		root * /srv/portada
		rewrite * /index.html
		file_server
	}
	handle /p/* {
		root * /srv/portada
		uri strip_prefix /p
		file_server
		header Cache-Control "public, max-age=86400"
	}

	reverse_proxy api:8000
}
